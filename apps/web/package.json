{
  "name": "mvtec-ad2-inspection-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "api:generate": "node scripts/generate-client.mjs",
    "api:check": "node scripts/generate-client.mjs --check",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "e2e": "playwright test",
    "verify:public-assets": "node scripts/verify-public-assets.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.51.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
